# This file lives in $JOBPILOT_HOME (default: repo root) next to knowledge/ and data/.

# Required
OPENROUTER_API_KEY="sk-or-v1-..."   # all LLM agents (models: agents.config.ts)
BRAVE_API_KEY="..."                 # job search

# Who you are looking for jobs as. Drives geo filtering (your own country is never "restricted").
# CANDIDATE_COUNTRY="Turkey"
# CANDIDATE_CITY="Istanbul"
# CANDIDATE_COUNTRY_ALIASES=""       # extra spellings, comma-separated (Türkiye is built in)
# CANDIDATE_REGIONS=""               # hiring regions open to you, e.g. "EMEA,MENA,Europe". Default: the regions
#                                    # your country is in (Turkey → EMEA, MENA). Also adds location search queries.

# Optional job search
# SERPAPI_KEY="..."                  # Google Jobs source (serpapi.com); skipped when unset
# MIN_MONTHLY_SALARY_USD=3000        # reject jobs stating a lower salary (0 = off)
# SEARCH_WINDOW_DAYS=                # how far back to search (1–7). Default: since the last search + 1 day

# Optional — name on generated resume files; falls back to the resume's first heading
# CANDIDATE_NAME="Jane Doe"

# Optional model overrides (defaults in agents.config.ts)
# TAILOR_EXTRACTION_MODEL=
# TAILOR_WRITING_MODEL=
# TAILOR_REVIEW_MODEL=
# TAILOR_FIT_MODEL=   # must be an OpenRouter Decisions model (default typesafe/jev-1.14)
# ELIGIBILITY_MODEL=   # must be an OpenRouter Decisions model (default typesafe/jev-1.14)
# ANSWER_MODEL=

# Optional tuning
# ATS_THRESHOLD=85
# MAX_ITERATIONS=3
# APPLY_PORT=4000
# DASHBOARD_PORT=3000
# CDP_URL=http://localhost:9222
