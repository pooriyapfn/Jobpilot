{
  "name": "jobpilot",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run -s cli",
    "cli": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=\"${JOBPILOT_HOME:-.}/.env.local\" apps/cli/src/index.ts",
    "search": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=\"${JOBPILOT_HOME:-.}/.env.local\" packages/engine/src/tools/job-search/index.ts",
    "verify": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=\"${JOBPILOT_HOME:-.}/.env.local\" packages/engine/src/tools/job-search/verify.ts",
    "enrich": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=\"${JOBPILOT_HOME:-.}/.env.local\" packages/engine/src/tools/job-search/enrich.ts",
    "report": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=\"${JOBPILOT_HOME:-.}/.env.local\" packages/engine/src/tools/job-search/report.ts",
    "jobs-dashboard": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=\"${JOBPILOT_HOME:-.}/.env.local\" packages/engine/src/tools/job-search/dashboard.ts",
    "tailor-batch": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=\"${JOBPILOT_HOME:-.}/.env.local\" packages/engine/src/tools/job-search/tailor-batch.ts",
    "setup-scheduler": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/engine/src/tools/job-search/setup-scheduler.ts",
    "unschedule": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/engine/src/tools/job-search/teardown-scheduler.ts",
    "tailor": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=\"${JOBPILOT_HOME:-.}/.env.local\" packages/engine/src/tools/tailor/runner.ts",
    "chrome": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/engine/src/browser/session.ts",
    "prepare-jobs": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=\"${JOBPILOT_HOME:-.}/.env.local\" packages/engine/src/agent/prepare.ts",
    "fill": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=\"${JOBPILOT_HOME:-.}/.env.local\" packages/engine/src/agent/fill.ts",
    "dashboard": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=\"${JOBPILOT_HOME:-.}/.env.local\" packages/engine/src/server/server.ts",
    "serve": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=\"${JOBPILOT_HOME:-.}/.env.local\" packages/engine/src/bin.ts serve",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test packages/engine/src/tools/job-search/tests/pipeline.test.ts packages/contracts/test/contracts.test.ts packages/engine/test/server.test.ts packages/engine/test/bin.test.ts",
    "contracts": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/contracts/scripts/generate.ts",
    "contracts:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/contracts/scripts/generate.ts --check",
    "typecheck": "tsc --noEmit",
    "macos:run": "swift run --package-path apps/macos",
    "macos:test": "swift test --package-path apps/macos"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
