{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "JobInfo.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "task": {
      "$ref": "JobTask.schema.json"
    },
    "status": {
      "$ref": "JobStatus.schema.json"
    },
    "startedAt": {
      "type": "string"
    },
    "endedAt": {
      "type": "string"
    },
    "exitCode": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "task",
    "status",
    "startedAt"
  ],
  "additionalProperties": false
}
