{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "EligibleJob.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "applicationStatus": {
      "allOf": [
        {
          "$ref": "Status.schema.json"
        }
      ]
    }
  },
  "required": [
    "id",
    "url",
    "title",
    "company"
  ],
  "additionalProperties": false
}
