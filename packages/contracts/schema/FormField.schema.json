{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "FormField.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "selector": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "type": {
      "$ref": "FieldType.schema.json"
    },
    "required": {
      "type": "boolean"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "selector",
    "label",
    "type",
    "required"
  ],
  "additionalProperties": false
}
